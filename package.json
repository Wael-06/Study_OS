{
  "name": "study-os",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"python3 app.py\" \"vite --host 0.0.0.0 --port 5000\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5000",
    "test:unit": "vitest run testing/unit",
    "test:integration": "start-server-and-test \"tsx testing/support/start-stack.ts\" http://127.0.0.1:5100 \"vitest run testing/integration\"",
    "test:e2e": "playwright test --config=testing/e2e/playwright.config.ts",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:load": "start-server-and-test \"tsx testing/support/start-stack.ts\" http://127.0.0.1:5100 \"tsx testing/performance/load-test.ts\""
  },
  "dependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.4",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "@playwright/test": "^1.55.0",
    "start-server-and-test": "^2.0.8",
    "tsx": "^4.19.2",
    "vitest": "^3.2.4"
  }
}
